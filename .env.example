# ---- VA Lead Radar configuration ----

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Telegram numeric user id of the admin who receives lead cards (required for
# delivery). Find yours with @userinfobot. Without it the bot still monitors and
# records leads, but delivers no cards (a warning is logged).
ADMIN_ID=123456789

# LLM API key (required). Works with Gemini or OpenAI depending on LLM_PROVIDER.
LLM_API_KEY=your-llm-api-key

# Which LLM backend to use: "gemini" or "openai" (default: gemini)
LLM_PROVIDER=gemini

# Optional model overrides
# LLM_MODEL=gemini-1.5-flash
# OPENAI_BASE_URL=https://api.openai.com/v1
# Extra models tried in order when the primary one fails (rate limits, outages).
# Free OpenRouter models return 429 often, so a chain keeps the bot working.
# LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.2-flash:free

# --- Storage ---------------------------------------------------------------
# Leave empty to use the local SQLite file (fine for local runs, VPS, Docker).
# On free hosts the disk is wiped on every redeploy, so put a free Postgres URL
# here instead (Neon, Render Postgres, Supabase) — including ?sslmode=require.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
DB_PATH=data/va_lead_radar.db

# --- Which chats to watch --------------------------------------------------
# false (default): only chats added with /addchat are monitored.
# true: every group/channel the bot is added to is adopted on its first message.
# Exclude a chat with /pause — a deleted chat would simply be re-adopted.
# MONITOR_ALL_CHATS=false

# --- External sources (main mode) ------------------------------------------
# The bot finds orders itself on freelance boards (RSS) and in public Telegram
# channels (t.me/s preview), so it never has to be added to a chat.
# POLL_SOURCES=false stops all polling; /poll still works on demand.
POLL_SOURCES=true
# Seconds between poll cycles (minimum 60). Public channel previews only show
# ~20 recent posts, so do not raise this much above the default.
POLL_INTERVAL=900
# Ignore postings older than this many days. A feed that has stopped still
# serves its last post forever, and it would otherwise arrive as a fresh lead.
# 0 disables the check.
MAX_ITEM_AGE_DAYS=30
# Seed a starter set of sources and broad keywords on first run. Set false to
# start with an empty list and add your own via /addsource.
SEED_DEFAULT_SOURCES=true

# --- Optional userbot (read ordinary chats / global search) ----------------
# The Bot API cannot read chats the bot is not a member of, and public previews
# only cover channels. A userbot logs in as a real account (MTProto) to reach
# ordinary groups and to search. It needs `pip install telethon`, and automating
# a user account risks limits or a ban — enable only if you accept that.
# Get api_id/api_hash at https://my.telegram.org, then generate the session:
#   python -c "from telethon.sync import TelegramClient; \
#     from telethon.sessions import StringSession; \
#     print(StringSession.save(TelegramClient(StringSession(), API_ID, 'API_HASH').start()))"
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_SESSION=your_session_string

# --- Mode ------------------------------------------------------------------
# Leave WEBHOOK_BASE_URL empty for long polling (local / VPS / Docker).
# On a free host set it to the public https URL; main.py then serves the webhook
# and the /health endpoint that keeps the instance awake.
# WEBHOOK_BASE_URL=https://my-bot.onrender.com
WEBHOOK_BASE_URL=
# Random string Telegram sends back in a header, so only Telegram can post updates.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
# Free hosts inject PORT; 8080 is the local default.
PORT=8080

# --- Logging / tuning (defaults shown) -------------------------------------
LOG_PATH=logs/bot.log
LOG_LEVEL=INFO
MAX_ANALYZE_CHARS=4000
